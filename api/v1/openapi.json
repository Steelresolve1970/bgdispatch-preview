    "operationId": "getPremium",
    "summary": "Premium feed (DISABLED scaffold). Would answer 402 Payment Required with payment instructions.",
    "parameters": [
     {
      "name": "dataset",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "402": {
      "description": "Payment required (scaffold only; not live)"
     },
     "404": {
      "description": "Premium disabled"
     }
    }
