      }
     },
     "highest_tier": {
      "type": "string"
     },
     "highest_tier_score": {
      "type": "integer"
     },
     "related_ids": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   },
   "Rumor": {
    "type": "object",
